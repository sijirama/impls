#pragma once

#include <cstddef>
#include "../cuda_runtime.h"

// Editor-only stand-ins for the CUDA pipeline API.
// LeetGPU provides the real implementation when the kernel is submitted.

namespace cuda {

struct thread_scope_block {};

template <typename Scope, std::size_t Stages>
struct pipeline_shared_state {};

template <typename Scope>
class pipeline {
public:
    pipeline() = default;

    template <std::size_t Stages>
    explicit pipeline(pipeline_shared_state<Scope, Stages>*) {}

    void producer_acquire() const {}
    void producer_commit() const {}
    void consumer_wait() const {}
    void consumer_release() const {}
};

template <typename Scope, std::size_t Stages>
pipeline<Scope> make_pipeline(pipeline_shared_state<Scope, Stages>* state) {
    return pipeline<Scope>(state);
}

template <typename Dst, typename Src, typename Scope>
void memcpy_async(Dst* destination, const Src* source, std::size_t bytes,
                  pipeline<Scope>& pipe) {
    (void)destination;
    (void)source;
    (void)bytes;
    (void)pipe;
}

template <typename Dst, typename Src, typename Scope>
void memcpy_async(Dst* destination, const Src* source, std::size_t bytes,
                  const pipeline<Scope>& pipe) {
    (void)destination;
    (void)source;
    (void)bytes;
    (void)pipe;
}

} // namespace cuda
